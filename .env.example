# Variáveis públicas do Supabase usadas pelo app Next.js.
# Valores reais: Vercel (production/preview) ou `vercel env pull .env.local` para dev.
#
# A publishable key é pública por design: o acesso é controlado por RLS e
# privilégios no banco. Chaves secretas (secret/service_role) e a senha do banco
# NUNCA entram em variáveis NEXT_PUBLIC_* nem na Vercel neste MVP.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
